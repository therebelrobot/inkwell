{
  "name": "inkwell",
  "version": "0.1.0",
  "description": "Self-hosted ink narrative editor for desktop and iPad: multi-file projects, live compile, play preview, knot graph.",
  "scripts": {
    "dev": "node --run dev:server & node --run dev:client",
    "dev:server": "INKWELL_DATA_DIR=./data tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "node --run build:client && node --run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/inkwell:dev .",
    "docker:run": "docker run --rm -p 3000:3000 -v \"$(pwd)/data:/app/data\" ghcr.io/therebelrobot/inkwell:dev",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/inkwell:dev --push .",
    "release:patch": "npm version patch -m 'release: %s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'release: %s' && git push --follow-tags",
    "release:major": "npm version major -m 'release: %s' && git push --follow-tags",
    "release:tags": "git tag --list \"v*\" --sort=-v:refname | head -n 10"
  },
  "author": "therebelrobot",
  "license": "Unlicense",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "inkjs": "^2.4.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
